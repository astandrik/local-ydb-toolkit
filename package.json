{
  "name": "local-ydb-toolkit",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run docs:check:built",
    "build:packages": "npm run build -w @local-ydb-toolkit/core && npm run build -w @astandrik/local-ydb-mcp",
    "predocs:generate": "npm run build:packages",
    "docs:generate": "node scripts/ci/generate-mcp-tools-docs.mjs --write",
    "predocs:check": "npm run build:packages",
    "docs:check": "npm run docs:check:built",
    "docs:check:built": "node scripts/ci/generate-mcp-tools-docs.mjs --check",
    "cleanup-helper:build": "node scripts/cleanup-helper/write-asset.mjs",
    "cleanup-helper:asset-check": "node scripts/cleanup-helper/asset-check.mjs",
    "cleanup-helper:rebuild-check": "node scripts/cleanup-helper/rebuild-check.mjs",
    "cleanup-helper:test": "node scripts/cleanup-helper/test-helper.mjs",
    "cleanup-helper:package-check": "node scripts/cleanup-helper/package-check.mjs",
    "plugin:package": "node scripts/package-agent-plugin.mjs",
    "plugin:smoke": "node scripts/ci/verify-published-plugin-mcp.mjs",
    "test": "vitest run",
    "posttest": "node --test scripts/ci/*.test.mjs",
    "typecheck": "npm run cleanup-helper:asset-check && npm run typecheck --workspaces"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "ajv": "8.20.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.5"
  }
}
